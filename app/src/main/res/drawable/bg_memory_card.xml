<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Matched pair -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#DCFCE7" />
            <stroke
                android:width="2dp"
                android:color="#15803D" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Revealed card -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF0DB" />
            <stroke
                android:width="2dp"
                android:color="#F97316" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Pressed hidden card -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0284C7" />
            <stroke
                android:width="2dp"
                android:color="#7DD3FC" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Hidden card -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#1256A0"
                android:endColor="#0085E8" />
            <stroke
                android:width="2dp"
                android:color="#60A5FA" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</selector>