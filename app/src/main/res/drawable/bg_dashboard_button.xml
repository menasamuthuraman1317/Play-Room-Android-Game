<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed button -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <gradient
                android:angle="90"
                android:startColor="#126B96"
                android:endColor="#35B8E8" />

            <stroke
                android:width="2dp"
                android:color="#F0C787" />

            <corners android:radius="4dp" />

        </shape>
    </item>

    <!-- Normal button -->
    <item>
        <layer-list>

            <!-- Bronze outer frame -->
            <item>
                <shape android:shape="rectangle">

                    <gradient
                        android:angle="90"
                        android:startColor="#49301E"
                        android:centerColor="#A77C4D"
                        android:endColor="#D5B58A" />

                    <corners android:radius="4dp" />

                </shape>
            </item>

            <!-- Dark inner border -->
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">

                <shape android:shape="rectangle">
                    <solid android:color="#071723" />
                    <corners android:radius="3dp" />
                </shape>

            </item>

            <!-- Glossy blue face -->
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">

                <shape android:shape="rectangle">

                    <gradient
                        android:angle="90"
                        android:startColor="#073650"
                        android:centerColor="#126A94"
                        android:endColor="#368FB5" />

                    <stroke
                        android:width="1dp"
                        android:color="#8CCAE0" />

                    <corners android:radius="2dp" />

                </shape>
            </item>

        </layer-list>
    </item>

</selector>