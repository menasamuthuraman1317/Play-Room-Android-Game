<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected mode -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#0085E8"
                android:endColor="#21A6ED" />

            <stroke
                android:width="2dp"
                android:color="#0078D4" />

            <corners android:radius="16dp" />

        </shape>
    </item>

    <!-- Unselected mode -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#E5E3DF" />

            <corners android:radius="16dp" />

        </shape>
    </item>

</selector>