<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/game_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/game_primary"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leaderboard"
            android:textColor="@color/game_surface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your achievements, saved on this device."
            android:textColor="@color/game_surface"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/spinnerLeaderboardGame"
            android:text="Choose a game"
            android:textColor="@color/game_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerLeaderboardGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:spinnerMode="dropdown" />

        <RadioGroup
            android:id="@+id/rgLeaderboardMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:checkedButton="@+id/rbLeaderboardSurvival">

            <RadioButton
                android:id="@+id/rbLeaderboardSurvival"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_mode_selector"
                android:buttonTint="@color/game_primary_dark"
                android:padding="8dp"
                android:text="Survival"
                android:textColor="@color/game_text"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbLeaderboardDuel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_mode_selector"
                android:buttonTint="@color/game_primary_dark"
                android:padding="8dp"
                android:text="Duel"
                android:textColor="@color/game_text"
                android:textSize="16sp" />

        </RadioGroup>

        <TextView
            android:id="@+id/tvLeaderboardSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Survival high scores"
            android:textColor="@color/game_primary_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLeaderboardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Loading results…"
            android:textColor="@color/game_text"
            android:textSize="14sp"
            android:accessibilityLiveRegion="polite" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutLeaderboardResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp" />

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLeaderboardBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_primary_button"
        android:backgroundTint="@null"
        android:text="Back to dashboard"
        android:textAllCaps="false"
        android:textColor="@color/game_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>