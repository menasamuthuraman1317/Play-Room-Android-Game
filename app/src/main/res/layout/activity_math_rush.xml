<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/game_background">

    <!-- Player 1: visible in Duel, rotated toward the opponent. -->
    <LinearLayout
        android:id="@+id/layoutMathP1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:rotation="180"
        android:padding="12dp"
        android:background="@color/game_info_background">

        <TextView
            android:id="@+id/tvMathP1Score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLAYER 1 • SCORE: 0"
            android:textColor="@color/game_primary_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvMathP1Question"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="12 + 8 = ?"
            android:textColor="@color/game_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMathP1Feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="Tap the correct answer"
            android:textColor="@color/game_text"
            android:textSize="14sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMathP1A"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_game_card"
                android:backgroundTint="@null"
                android:text="18"
                android:textColor="@color/game_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMathP1B"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_game_card"
                android:backgroundTint="@null"
                android:text="20"
                android:textColor="@color/game_text"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMathP1C"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_game_card"
                android:backgroundTint="@null"
                android:text="22"
                android:textColor="@color/game_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMathP1D"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_game_card"
                android:backgroundTint="@null"
                android:text="24"
                android:textColor="@color/game_text"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <!-- Shared timer and pause control. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/game_primary_dark"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvMathMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MATH RUSH • SURVIVAL"
                android:textColor="@color/game_surface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMathTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TIME: 30s"
                android:textColor="@color/game_surface"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMathPause"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_game_card"
            android:backgroundTint="@null"
            android:text="Pause"
            android:textAllCaps="false"
            android:textColor="@color/game_primary_dark"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Player 2: also used as the solo player's area. -->
    <LinearLayout
        android:id="@+id/layoutMathP2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvMathP2Score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCORE: 0"
            android:textColor="@color/game_primary_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvMathP2Question"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="12 + 8 = ?"
            android:textColor="@color/game_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMathP2Feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="Tap the correct answer"
            android:textColor="@color/game_text"
            android:textSize="14sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMathP2A"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_game_card"
                android:backgroundTint="@null"
                android:text="18"
                android:textColor="@color/game_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMathP2B"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_game_card"
                android:backgroundTint="@null"
                android:text="20"
                android:textColor="@color/game_text"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMathP2C"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_game_card"
                android:backgroundTint="@null"
                android:text="22"
                android:textColor="@color/game_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMathP2D"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_game_card"
                android:backgroundTint="@null"
                android:text="24"
                android:textColor="@color/game_text"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>